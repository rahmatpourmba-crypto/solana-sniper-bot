# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already listed in .gitignore.

# Solana wallet private key (only needed for live trading)
PHANTOM_PRIVATE_KEY=

# Telegram alerts (create a bot via @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom Solana RPC endpoint (defaults to the public pool)
SOLANA_RPC_URL=

# Optional: HTTP proxy, e.g. http://127.0.0.1:10809 (leave empty if not needed)
HTTP_PROXY=
