# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already listed in .gitignore.

# --- MODE ---
# true (default) = paper trading with virtual SOL. false = live trading.
SIMULATION_MODE=true
# SAFETY: with SIMULATION_MODE=false, LIVE_DRY_RUN=true builds & signs
# transactions but NEVER broadcasts them. Set to false only when ready.
LIVE_DRY_RUN=true

# Solana wallet private key (base58 export or JSON byte array).
# REQUIRED for live trading. Never share it — .env is gitignored.
PHANTOM_PRIVATE_KEY=

# Telegram alerts (create a bot via @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom Solana RPC endpoint (defaults to the public pool)
SOLANA_RPC_URL=

# Optional: HTTP proxy, e.g. http://127.0.0.1:10809 (leave empty if not needed)
HTTP_PROXY=

# Optional: slippage tolerance in basis points (300 = 3%)
SLIPPAGE_BPS=300
